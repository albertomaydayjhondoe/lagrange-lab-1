%%{init: {'theme': 'base', 'themeVariables': { 
    'primaryColor': '#1d3557',
    'primaryTextColor': '#fff',
    'primaryBorderColor': '#1d3557',
    'lineColor': '#457b9d',
    'secondaryColor': '#457b9d',
    'tertiaryColor': '#a8dadc',
    'fontFamily': 'system-ui, -apple-system, sans-serif'
}}%%
flowchart TB
    %% ===== ESTILOS =====
    classDef paas fill:#1d3557,color:#fff,stroke:#0d1b2a,stroke-width:3px
    classDef paas-light fill:#264653,color:#fff,stroke:#1d3557
    classDef saas fill:#457b9d,color:#fff,stroke:#1d3557,stroke-width:2px
    classDef saas-light fill:#a8dadc,color:#111,stroke:#457b9d
    classDef student fill:#f1faee,color:#111,stroke:#1d3557,stroke-width:2px
    classDef connector stroke:#e63946,color:#e63946,stroke-width:2px
    classDef ui-panel fill:#2a9d8f,color:#fff,stroke:#264653

    %% ===== TÍTULO =====
    subgraph TITLE["🏗️ ARQUITECTURA LAGRANGE LAB - SOBERANÍA MULTINIVEL"]
        direction LR
        T1["<b>PaaS</b><br/>Soberanía de Plataforma"] 
        T2["<b>SaaS</b><br/>Soberanía de Academia"]
        T3["<b>Estudiante</b><br/>Soberanía de Portfolio"]
        T1 --> T2 --> T3
        style T1 fill:#1d3557,color:#fff
        style T2 fill:#457b9d,color:#fff
        style T3 fill:#a8dadc,color:#111
    end

    %% ===== NIVEL 1: PaaS - Soberanía de Plataforma =====
    subgraph L1["<b>📦 NIVEL 1 — PaaS</b><br/>Soberanía de Plataforma<br/><sub>super-admin · Alberto</sub>"]
        direction TB
        L1UI["<b>🖥️ Panel de Plataforma</b><br/>super-admin · Alberto"]
        L1A["<b>⚙️ Provisión de Tenants</b><br/>core/tenancy"]
        L1B["<b>🎨 Branding / White-label</b><br/>frontend por tenant"]
        L1C["<b>⚡ Core/Runtime</b><br/>llm-gateway · rag-engine · function-registry"]
        L1D["<b>📋 Planes y Límites</b><br/>features activadas por academia"]
        
        L1UI --> L1A
        L1UI --> L1B
        L1UI --> L1C
        L1UI --> L1D
    end

    %% ===== NIVEL 2: SaaS - Soberanía de Academia =====
    subgraph L2["<b>🏛️ NIVEL 2 — SaaS</b><br/>Soberanía de Academia<br/><sub>Academia Lexis · tutor/owner</sub>"]
        direction TB
        L2UI["<b>🖥️ Panel de Academia</b><br/>rol: tutor/owner de tenant"]
        L2A["<b>👥 Alta/Baja de Estudiantes</b><br/>academy_members"]
        L2B["<b>📚 Gestión de Asignaturas</b><br/>subjects (scope academy_id)"]
        L2C["<b>📚 Corpus RAG de Asignaturas</b><br/>servido y gestionado por el centro"]
        L2D["<b>🔓 Activación de Features</b><br/>dentro del plan asignado por Nivel 1"]
        
        L2UI --> L2A
        L2UI --> L2B
        L2UI --> L2C
        L2UI --> L2D
    end

    %% ===== NIVEL 3: Estudiante - Soberanía de Portfolio =====
    subgraph L3["<b>🎓 NIVEL 3 — Estudiante</b><br/>Soberanía de Portfolio Propio<br/><sub>alumno</sub>"]
        direction TB
        L3UI["<b>🖥️ Mi Portfolio</b><br/>rol: alumno"]
        L3A["<b>📝 Selección de Asignaturas</b><br/>a cursar (subset de L2B)"]
        L3B["<b>📝 Notas Personales</b><br/>Aportar Apuntes (privado, opcional)"]
        L3C["<b>🔮 Historial Q&A del Oráculo</b><br/>sobre el corpus del centro"]
        L3D["<b>📂 Portfolio Personal</b><br/>corpus del centro + notas propias<br/>(no visible a otros alumnos)"]
        
        L3UI --> L3A
        L3UI --> L3B
        L3UI --> L3C
        L3UI --> L3D
    end

    %% ===== CONEXIONES L1 → L2 =====
    L1D -. "<b>define límites del plan</b>" .-> L2UI
    L1C -. "<b>sirve el motor a</b>" .-> L2UI
    L1B -. "<b>aplica marca/tema a</b>" .-> L2UI

    %% ===== CONEXIONES L2 → L3 =====
    L2B -. "<b>expone catálogo de asignaturas</b>" .-> L3A
    L2C -. "<b>sirve el corpus base para el Oráculo</b>" .-> L3C
    L2C -. "<b>se compone en</b>" .-> L3D
    L2D -. "<b>determina qué ve el alumno</b>" .-> L3UI

    %% ===== CONEXIONES L3 → L2 (retroalimentación) =====
    L3B -. "<b>enriquece solo su propio portfolio</b>" .-> L3D
    L3C -. "<b>queda auditable por</b>" .-> L2UI

    %% ===== CONEXIONES ENTRE NIVELES =====
    L1 -. "<b>provisiona tenant</b>" .-> L2
    L2 -. "<b>credenciales de acceso</b>" .-> L3

    %% Aplicar estilos
    class L1UI,L1A,L1B,L1C,L1D paas
    class L2UI,L2A,L2B,L2C,L2D saas
    class L3UI,L3A,L3B,L3C,L3D student
    class TITLE ui-panel

    %% ===== LEYENDA =====
    subgraph LEGEND["<b>🔑 LEYENDA</b>"]
        direction LR
        L_PaaS["<b>PaaS</b><br/>Nivel 1"] 
        L_SaaS["<b>SaaS</b><br/>Nivel 2"] 
        L_Est["<b>Estudiante</b><br/>Nivel 3"]
        L_Dash["--- →<br/>Flujo de datos"]
        L_DDot["-.- →<br/>Config/Control"]
        
        style L_PaaS fill:#1d3557,color:#fff
        style L_SaaS fill:#457b9d,color:#fff
        style L_Est fill:#a8dadc,color:#111
        style L_Dash fill:#e63946,color:#fff
        style L_DDot fill:#f4a261,color:#fff
    end
