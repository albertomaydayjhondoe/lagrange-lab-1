# Supabase Production Configuration
# Copy this file to .env.production and fill in your OWN project values.
#
# UNIVERSALITY: Lagrange Lab is project-agnostic. Point it at ANY Supabase
# project and deploy to ANY Vercel project — no project ref is hardcoded
# in the source. Fill the three vars below with your own values.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
